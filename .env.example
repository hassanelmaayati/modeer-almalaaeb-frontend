# Local development uses the Vite HTTP/WebSocket proxy.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Vercel Production: set VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com/api/v1
# VITE_API_PROXY_TARGET is local-only. Never put DB credentials or JWT_SECRET here.

# Optional: leave empty to hide Google sign-in. Must match the backend client ID.
VITE_GOOGLE_CLIENT_ID=
